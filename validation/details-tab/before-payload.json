  "bullet_point": [
    {
      "marketplace_id": "A2EUQ1WTGCTBG2",
      "language_tag": "en_US",
      "value": "Simplified hair dryer. Includes 1 attachment."
    },
    {
      "marketplace_id": "A2EUQ1WTGCTBG2",
      "language_tag": "en_US",
      "value": "Protects hair from extreme heat damage, with fast drying and controlled styling to help increase smoothness by 75%, increase shine by up to 132%, and decrease frizz and flyaways by up to 61%.¹"
    },
    {
      "marketplace_id": "A2EUQ1WTGCTBG2",
      "language_tag": "en_US",
      "value": "Fast drying. The small, powerful motor combined with Air Multiplier technology produces a high-pressure, high-velocity jet of controlled air for fast drying and precision styling."
    },
    {
      "marketplace_id": "A2EUQ1WTGCTBG2",
      "language_tag": "en_US",
      "value": "Intelligent heat control. The Dyson Supersonic hair dryer measures air temperature over 40 times a second and regulates the heat. This prevents extreme heat damage, to help protect your hair's shine."
    },
    {
      "marketplace_id": "A2EUQ1WTGCTBG2",
      "language_tag": "en_US",
      "value": "The magnetic Styling concentrator attachment adjusts quickly and easily. Heat Shield technology keeps the surfaces of the attachment cool, even during close up styling."
    },
    {
      "marketplace_id": "A2EUQ1WTGCTBG2",
      "language_tag": "en_US",
      "value": "Acoustically tuned. The powerful motor is tuned to produce one inaudible frequency."
    },
    {
      "marketplace_id": "A2EUQ1WTGCTBG2",
      "language_tag": "en_US",
      "value": "Negative ions help reduce static in the hair."
    },
    {
      "marketplace_id": "A2EUQ1WTGCTBG2",
      "language_tag": "en_US",
      "value": "Three precise airflow settings: High for fast drying and styling, Medium for regular drying, Low for gentle drying."
    },
    {
      "marketplace_id": "A2EUQ1WTGCTBG2",
      "language_tag": "en_US",
      "value": "Four precise heat settings: 212°F for fast drying and styling, 176°F for regular drying, 140°F for gentle drying, 82°F constant cool to set your style."
    },
    {
      "marketplace_id": "A2EUQ1WTGCTBG2",
      "language_tag": "en_US",
      "value": "Instant control with 82°F cold shot to set your hair after styling."
    }
  ],
